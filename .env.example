# Path /run/secrets/... berlaku di container, bukan otomatis tersedia di Windows.
# Untuk proses lokal, ganti dengan path file lokal yang dapat dibaca; loader tidak memuat .env.

# Redis: gateway, worker, api, ops.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD_FILE=/run/secrets/redis_password

# PostgreSQL: worker, api, migrate. Pilih PGPASSWORD_FILE sesuai role layanan.
PGHOST=db
PGPORT=5432
PGDATABASE=monitoring
# PGUSER default: worker=monitor_worker, api=monitor_reader, migrate=postgres.
# PGUSER=monitor_worker
# Worker:
PGPASSWORD_FILE=/run/secrets/postgres_worker_password
# API: PGPASSWORD_FILE=/run/secrets/postgres_reader_password
# Migrate: PGPASSWORD_FILE=/run/secrets/postgres_password

# Gateway: isi ALLOWED_GROUP_IDS dengan ID grup yang disetujui sebelum mode normal.
SESSION_KEY=monitoring
PAIRING_MODE=false
ALLOWED_GROUP_IDS=[]
# Pairing boleh memakai allowlist kosong jika PAIRING_MODE=true.

# API saja.
API_READ_TOKEN_FILE=/run/secrets/api_read_token
OPS_USER=operator
OPS_PASSWORD_FILE=/run/secrets/ops_password

# Migrate saja: password untuk role yang akan disiapkan migrasi.
POSTGRES_WORKER_PASSWORD_FILE=/run/secrets/postgres_worker_password
POSTGRES_READER_PASSWORD_FILE=/run/secrets/postgres_reader_password
