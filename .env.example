# Compose membaca file ini; loader Node membutuhkan variabel proses.
# Gunakan node scripts/setup-secrets.mjs create; tidak ada nilai credential di sini.
# WSL: DrvFS ditolak termasuk metadata POSIX; pilih filesystem Linux native dengan --directory.
SECRETS_DIR=./secrets

SESSION_KEY=monitoring
PAIRING_MODE=false
ALLOWED_GROUP_IDS=[]
OPS_USER=operator
PGADMIN_DEFAULT_EMAIL=operator@example.com

# Referensi proses lokal saja; Compose memasang nilai per service, bukan seluruh env ini.
# Ganti /run/secrets dengan path lokal jika menjalankan proses di luar container.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD_FILE=/run/secrets/redis-password
PGHOST=db
PGPORT=5432
PGDATABASE=monitoring
# PGUSER: worker=monitor_worker, api=monitor_reader, migrate=postgres.
PGPASSWORD_FILE=/run/secrets/postgres-worker-password
# API: PGPASSWORD_FILE=/run/secrets/postgres-reader-password
# Migrate: PGPASSWORD_FILE=/run/secrets/postgres-admin-password
POSTGRES_WORKER_PASSWORD_FILE=/run/secrets/postgres-worker-password
POSTGRES_READER_PASSWORD_FILE=/run/secrets/postgres-reader-password
API_READ_TOKEN_FILE=/run/secrets/api-read-token
OPS_PASSWORD_FILE=/run/secrets/ops-password
